{
  "name": "neural-network",
  "version": "1.0.0",
  "category": "ai-education",
  "description": "神经网络拓扑图，支持逐层构建动画和信号传递动画",
  "params": {
    "type": "object",
    "properties": {
      "layers": {
        "type": "array",
        "description": "每层神经元配置",
        "items": {
          "type": "object",
          "properties": {
            "neurons": { "type": "number", "description": "神经元数量" },
            "label": { "type": "string", "description": "层名称" }
          },
          "required": ["neurons"]
        }
      },
      "signalFlow": { "type": "boolean", "description": "是否显示信号传递动画", "default": true },
      "speed": { "type": "number", "description": "动画速度倍率", "default": 1 },
      "colors": {
        "type": "object",
        "description": "自定义颜色",
        "properties": {
          "input": { "type": "string", "default": "#667eea" },
          "hidden": { "type": "string", "default": "#764ba2" },
          "output": { "type": "string", "default": "#e94560" },
          "connection": { "type": "string", "default": "rgba(102,126,234,0.3)" },
          "signal": { "type": "string", "default": "#FFD700" }
        }
      }
    },
    "required": ["layers"]
  }
}
