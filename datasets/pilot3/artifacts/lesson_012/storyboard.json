    {
      "id": 6,
      "narration": "西部数据中心主要处理“冷数据”，也就是存储时间长、调用频率低的数据。例如后台加工、离线分析和存储备份。只有当我们真正需要这些数据时，才会进行计算。这与东部处理“热数据”形成鲜明对比。",
      "knowledge_point_ids": [
        "kp4"
      ],
      "visual_type": "illustration",
      "render_mode": "template",
      "elements": [
        {
          "id": "e1",
          "type": "heading",
          "text": "冷数据 vs 热数据"
        },
        {
          "id": "img1",
          "type": "image",
          "description": "冷数据与热数据概念图"
        },
        {
