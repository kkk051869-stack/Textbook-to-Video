    {
      "id": 3,
      "narration": "今天，数据几乎渗透到我们生活的方方面面。电信运营商记录通话数据，银行存储用户信息，学校管理学生的考勤和成绩——这些数据都服务于具体功能。在互联网兴起之前，数据一直是经济与社会活动的“副产品”，为人们的生活和生产服务。",
      "knowledge_point_ids": [
        "kp3"
      ],
      "visual_type": "definition",
      "render_mode": "template",
      "elements": [
        {
          "id": "e1",
          "type": "heading",
          "text": "数据在当代社会的渗透"
        },
        {
          "id": "e2",
          "type": "icon_group",
          "items": [
            "电信",
