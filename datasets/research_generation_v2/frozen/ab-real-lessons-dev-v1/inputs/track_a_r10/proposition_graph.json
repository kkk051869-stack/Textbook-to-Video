      "status": "LLM_PROPOSED_NARRATION_GROUNDING_PENDING_HUMAN_REVIEW"
    },
    {
      "id": "lesson-002-seg-5-nprop-013",
      "segment_id": "5",
      "text": "哈希还有一个重要特性——它不可逆。",
      "span": {
        "start": 0,
        "end": 17,
        "unit": "unicode_codepoint",
        "end_exclusive": true
