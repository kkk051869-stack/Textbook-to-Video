  "knowledge_propositions": [
    {
      "id": "lesson-002-kprop-001",
      "knowledge_point_id": "kp1",
      "text": "区块链是比特币的核心技术。",
      "source_refs": [
        "raw-unit-0016"
      ],
      "status": "LLM_PROPOSED_SOURCE_GROUNDED_PENDING_HUMAN_REVIEW"
    },
    {
      "id": "lesson-002-kprop-002",
      "knowledge_point_id": "kp1",
      "text": "区块链是一种分布式记账方式。",
      "source_refs": [
        "raw-unit-0017",
        "raw-unit-0012"
      ],
      "status": "LLM_PROPOSED_SOURCE_GROUNDED_PENDING_HUMAN_REVIEW"
    },
    {
      "id": "lesson-002-kprop-003",
      "knowledge_point_id": "kp1",
      "text": "区块链用于解决长期存在的信任问题。",
      "source_refs": [
        "raw-unit-0017",
        "raw-unit-0019"
      ],
      "status": "LLM_PROPOSED_SOURCE_GROUNDED_PENDING_HUMAN_REVIEW"
    },
    {
      "id": "lesson-002-kprop-004",
      "knowledge_point_id": "kp2",
      "text": "区块链实质上是一种分布式记账方式。",
      "source_refs": [
        "raw-unit-0012"
      ],
      "status": "LLM_PROPOSED_SOURCE_GROUNDED_PENDING_HUMAN_REVIEW"
    },
    {
      "id": "lesson-002-kprop-005",
      "knowledge_point_id": "kp2",
      "text": "在区块链中，所有参与者均维护一份完整的账本（区块链）。",
      "source_refs": [
        "raw-unit-0012"
      ],
      "status": "LLM_PROPOSED_SOURCE_GROUNDED_PENDING_HUMAN_REVIEW"
    },
    {
      "id": "lesson-002-kprop-006",
      "knowledge_point_id": "kp2",
      "text": "当部分参与者试图修改账本时，会导致账本之间出现信息不一致。",
      "source_refs": [
        "raw-unit-0012"
      ],
      "status": "LLM_PROPOSED_SOURCE_GROUNDED_PENDING_HUMAN_REVIEW"
    },
    {
      "id": "lesson-002-kprop-007",
      "knowledge_point_id": "kp2",
      "text": "其余参与方可以基于少数服从多数的原则来确认账本的真实性。",
      "source_refs": [
        "raw-unit-0012"
      ],
      "status": "LLM_PROPOSED_SOURCE_GROUNDED_PENDING_HUMAN_REVIEW"
    },
    {
      "id": "lesson-002-kprop-008",
      "knowledge_point_id": "kp3",
      "text": "区块链采用链式数据结构，由多个区块组成。",
      "source_refs": [
        "raw-unit-0012"
      ],
      "status": "LLM_PROPOSED_SOURCE_GROUNDED_PENDING_HUMAN_REVIEW"
    },
    {
      "id": "lesson-002-kprop-009",
      "knowledge_point_id": "kp3",
      "text": "每个区块既包括诸如“上一区块的哈希散列”、“随机数”这样的基础信息，也包括交易执行记录。",
      "source_refs": [
        "raw-unit-0012"
      ],
      "status": "LLM_PROPOSED_SOURCE_GROUNDED_PENDING_HUMAN_REVIEW"
    },
    {
      "id": "lesson-002-kprop-010",
      "knowledge_point_id": "kp3",
      "text": "哈希函数是密码学中的重要手段，可以依据一串输入数据创建一个简短的哈希散列值。",
      "source_refs": [
        "raw-unit-0013"
      ],
      "status": "LLM_PROPOSED_SOURCE_GROUNDED_PENDING_HUMAN_REVIEW"
    },
    {
      "id": "lesson-002-kprop-011",
      "knowledge_point_id": "kp3",
      "text": "输入数据即使发生微小变动，也会导致输出信息发生显著变化。",
      "source_refs": [
        "raw-unit-0013"
      ],
      "status": "LLM_PROPOSED_SOURCE_GROUNDED_PENDING_HUMAN_REVIEW"
    },
    {
      "id": "lesson-002-kprop-012",
      "knowledge_point_id": "kp3",
      "text": "每个区块链中保留的“上一区块的哈希散列值”可反应出上一区块内的数据是否曾被篡改过了。",
      "source_refs": [
        "raw-unit-0013"
      ],
      "status": "LLM_PROPOSED_SOURCE_GROUNDED_PENDING_HUMAN_REVIEW"
    },
    {
      "id": "lesson-002-kprop-013",
      "knowledge_point_id": "kp3",
      "text": "比特币系统中每笔交易被描述为多个输入/输出UTXO",
      "source_refs": [
        "raw-unit-0012"
      ],
      "status": "LLM_PROPOSED_SOURCE_GROUNDED_PENDING_HUMAN_REVIEW"
    },
    {
      "id": "lesson-002-kprop-014",
      "knowledge_point_id": "kp3",
      "text": "UTXO指尚未被花费的交易输出",
      "source_refs": [
        "raw-unit-0012"
      ],
      "status": "LLM_PROPOSED_SOURCE_GROUNDED_PENDING_HUMAN_REVIEW"
    },
    {
      "id": "lesson-002-kprop-015",
      "knowledge_point_id": "kp3",
      "text": "在拥有0.5和0.3比特币UTXO并支付0.6比特币时，系统生成0.6比特币的UTXO给接收者",
      "source_refs": [
        "raw-unit-0012"
      ],
      "status": "LLM_PROPOSED_SOURCE_GROUNDED_PENDING_HUMAN_REVIEW"
    },
    {
      "id": "lesson-002-kprop-016",
      "knowledge_point_id": "kp3",
      "text": "在拥有0.5和0.3比特币UTXO并支付0.6比特币时，系统生成0.2比特币的UTXO找零给自己",
      "source_refs": [
        "raw-unit-0012"
      ],
      "status": "LLM_PROPOSED_SOURCE_GROUNDED_PENDING_HUMAN_REVIEW"
    },
    {
      "id": "lesson-002-kprop-017",
      "knowledge_point_id": "kp4",
      "text": "哈希函数无法基于输出的哈希散列值反推出原始数据，即具有不可逆性。",
      "source_refs": [
        "raw-unit-0013"
      ],
      "status": "LLM_PROPOSED_SOURCE_GROUNDED_PENDING_HUMAN_REVIEW"
    },
    {
      "id": "lesson-002-kprop-018",
      "knowledge_point_id": "kp4",
      "text": "输入数据即使发生微小变动，也会导致哈希输出信息发生显著变化。",
      "source_refs": [
        "raw-unit-0013"
      ],
      "status": "LLM_PROPOSED_SOURCE_GROUNDED_PENDING_HUMAN_REVIEW"
    },
    {
      "id": "lesson-002-kprop-019",
      "knowledge_point_id": "kp4",
      "text": "区块链中每个区块保留上一区块的哈希散列值，可用于反映上一区块内的数据是否曾被篡改。",
      "source_refs": [
        "raw-unit-0013",
        "raw-unit-0012"
      ],
      "status": "LLM_PROPOSED_SOURCE_GROUNDED_PENDING_HUMAN_REVIEW"
    },
    {
      "id": "lesson-002-kprop-020",
      "knowledge_point_id": "kp4",
      "text": "基于原有区块的哈希散列值已被分布式记账，因此无法在不改变上一区块哈希散列值的情况下修改交易记录。",
      "source_refs": [
        "raw-unit-0013"
      ],
      "status": "LLM_PROPOSED_SOURCE_GROUNDED_PENDING_HUMAN_REVIEW"
    },
    {
      "id": "lesson-002-kprop-021",
      "knowledge_point_id": "kp5",
      "text": "比特币白皮书发布于2008年10月，其发布背景与美国2007年夏天爆发的次贷危机及随后的全球性金融危机有关。",
      "source_refs": [
        "raw-unit-0016"
      ],
      "status": "LLM_PROPOSED_SOURCE_GROUNDED_PENDING_HUMAN_REVIEW"
    },
    {
      "id": "lesson-002-kprop-022",
      "knowledge_point_id": "kp5",
      "text": "次贷危机动摇了公众对金融机构的信心以及金融机构之间的信任关系。",
      "source_refs": [
        "raw-unit-0016"
      ],
      "status": "LLM_PROPOSED_SOURCE_GROUNDED_PENDING_HUMAN_REVIEW"
    },
    {
      "id": "lesson-002-kprop-023",
      "knowledge_point_id": "kp5",
      "text": "区块链技术作为一种分布式记账方式，使所有人参与其中，而非依赖中心化的金融机构。",
      "source_refs": [
        "raw-unit-0017"
      ],
      "status": "LLM_PROPOSED_SOURCE_GROUNDED_PENDING_HUMAN_REVIEW"
    },
    {
      "id": "lesson-002-kprop-024",
      "knowledge_point_id": "kp5",
      "text": "区块链通过数据和数学建立信任关系，使得即使互不了解的人之间也能建立信任。",
      "source_refs": [
        "raw-unit-0021"
      ],
      "status": "LLM_PROPOSED_SOURCE_GROUNDED_PENDING_HUMAN_REVIEW"
    },
    {
      "id": "lesson-002-kprop-025",
      "knowledge_point_id": "kp5",
      "text": "使用区块链后，无需基于现有信用体系建立信任。",
      "source_refs": [
        "raw-unit-0021"
      ],
      "status": "LLM_PROPOSED_SOURCE_GROUNDED_PENDING_HUMAN_REVIEW"
    },
    {
      "id": "lesson-002-kprop-026",
      "knowledge_point_id": "kp3",
      "text": "区块链综合采用了密码学、信息论、信息安全、隐私保护、计算机网络等技术。",
      "source_refs": [
        "raw-unit-0019"
      ],
      "status": "LLM_PROPOSED_SOURCE_GROUNDED_PENDING_HUMAN_REVIEW"
    },
    {
      "id": "lesson-002-kprop-027",
      "knowledge_point_id": "kp3",
      "text": "在计算机技术的支持下，区块链形成了分布式多副本、加密安全、不可篡改等特性。",
      "source_refs": [
        "raw-unit-0020"
