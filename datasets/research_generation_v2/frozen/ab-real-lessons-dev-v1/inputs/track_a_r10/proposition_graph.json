      "status": "LLM_PROPOSED_NARRATION_GROUNDING_PENDING_HUMAN_REVIEW"
    },
    {
      "id": "lesson-002-seg-4-nprop-011",
      "segment_id": "4",
      "text": "用户拥有0.5和0.3比特币的UTXO，也就是未花费交易输出。",
      "span": {
        "start": 5,
        "end": 36,
        "unit": "unicode_codepoint",
        "end_exclusive": true
