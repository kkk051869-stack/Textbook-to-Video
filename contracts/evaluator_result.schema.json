{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://textbookeval.local/schemas/evaluator-result-v0.1.json",
  "title": "TextbookEval Evaluator Result v0.1",
  "type": "object",
  "additionalProperties": false,
  "required": ["evaluator", "status", "issues", "evidence_ids"],
  "properties": {
    "evaluator": {"type": "string", "minLength": 1},
    "status": {"type": "string", "enum": ["ok", "failed", "error", "skipped", "unavailable"]},
    "passed": {"type": ["boolean", "null"]},
    "started_at": {"type": ["string", "null"]},
    "finished_at": {"type": ["string", "null"]},
    "duration_sec": {"type": ["number", "null"], "minimum": 0},
    "metrics": {"type": "object"},
    "details": {"type": "object"},
    "issues": {"type": "array", "items": {"$ref": "eval-issue-v0.2.json"}},
    "evidence_ids": {"type": "array", "items": {"type": "string"}},
    "evidence": {"type": "array", "items": {"$ref": "evidence-v0.1.json"}}
  }
}
