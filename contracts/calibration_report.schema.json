{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://textbookeval.local/schemas/calibration-report-v0.1.json",
  "title": "TextbookEval Calibration Report v0.1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "unit_count", "pending_human_label_count", "evaluators", "units", "metadata"],
  "properties": {
    "schema_version": {"const": "textbookeval-calibration-v0.1"},
    "unit_count": {"type": "integer", "minimum": 0},
    "pending_human_label_count": {"type": "integer", "minimum": 0},
    "evaluators": {"type": "object"},
    "units": {"type": "array", "items": {"type": "object"}},
    "metadata": {"type": "object"}
  }
}
