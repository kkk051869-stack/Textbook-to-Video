{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://textbookeval.local/schemas/regression-fixture-v0.1.json",
  "title": "TextbookEval Regression Fixture v0.1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "fixture_id", "case_id", "source_issue", "input_conditions", "expected_invariants", "evaluator", "promotion"],
  "properties": {
    "schema_version": {"const": "textbookeval-regression-fixture-v0.1"},
    "fixture_id": {"type": "string", "minLength": 1},
    "case_id": {"type": "string", "minLength": 1},
    "source_issue": {"type": "object"},
    "input_conditions": {"type": "object"},
    "expected_invariants": {"type": "array", "minItems": 1, "items": {"type": "object"}},
    "evaluator": {"type": "string", "minLength": 1},
    "promotion": {
      "type": "object",
      "required": ["confirmed", "requires_targeted_re_eval"],
      "properties": {
        "confirmed": {"const": true},
        "requires_targeted_re_eval": {"const": true}
      }
    },
    "replay": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "fault_storyboard", "repaired_storyboard"],
      "properties": {
        "kind": {"const": "storyboard"},
        "fault_storyboard": {"type": "object"},
        "repaired_storyboard": {"type": "object"}
      }
    }
  }
}
