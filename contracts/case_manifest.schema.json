{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://textbookeval.local/schemas/case-manifest-v0.1.json",
  "title": "TextbookEval Case Manifest v0.1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "case_id", "lesson_id", "status", "dataset_version", "source"],
  "properties": {
    "schema_version": {"const": "textbookeval-case-v0.1"},
    "case_id": {"type": "string", "minLength": 1},
    "lesson_id": {"type": "string", "minLength": 1},
    "status": {"type": "string", "enum": ["candidate", "frozen", "retired"]},
    "dataset_version": {"type": "string", "minLength": 1},
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": ["files"],
      "properties": {
        "files": {
          "type": "array",
          "minItems": 1,
          "items": {"$ref": "#/$defs/fileAsset"}
        }
      }
    },
    "annotation": {"$ref": "#/$defs/fileAsset"},
    "heldout_questions": {"$ref": "#/$defs/fileAsset"},
    "review": {
      "type": "object",
      "additionalProperties": false,
      "required": ["annotation_status", "reviewer", "reviewed_at"],
      "properties": {
        "annotation_status": {"type": "string", "enum": ["draft", "in_review", "frozen"]},
        "reviewer": {"type": "string", "minLength": 1},
        "reviewed_at": {"type": "string", "minLength": 1},
        "notes": {"type": "string"}
      }
    },
    "expected": {"type": "object"},
    "systems": {"type": "object"},
    "baseline_artifacts": {"type": "object"},
    "metadata": {"type": "object"}
  },
  "allOf": [
    {
      "if": {"properties": {"status": {"const": "frozen"}}},
      "then": {
        "required": ["annotation", "heldout_questions", "review"],
        "properties": {
          "review": {"properties": {"annotation_status": {"const": "frozen"}}}
        }
      }
    }
  ],
  "$defs": {
    "fileAsset": {
      "type": "object",
      "additionalProperties": false,
      "required": ["role", "path", "sha256"],
      "properties": {
        "role": {"type": "string", "minLength": 1},
        "path": {"type": "string", "minLength": 1},
        "sha256": {"type": "string", "pattern": "^[a-fA-F0-9]{64}$"},
        "required": {"type": "boolean", "default": true},
        "review_status": {"type": "string"}
      }
    }
  }
}
