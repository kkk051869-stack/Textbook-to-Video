{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://textbook-to-video.local/contracts/ab_dataset_manifest_v1.schema.json",
  "title": "Textbook-to-Video frozen A/B dataset manifest v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "dataset_id", "split", "case_ids", "files"],
  "properties": {
    "schema_version": {"const": "t2v-ab-dataset-manifest-v1"},
    "dataset_id": {"type": "string", "minLength": 1},
    "split": {"enum": ["dev", "validation", "locked-test"]},
    "case_ids": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {"type": "string", "minLength": 1}
    },
    "files": {
      "type": "array",
      "minItems": 1,
      "items": {"$ref": "#/$defs/file"}
    }
  },
  "$defs": {
    "file": {
      "type": "object",
      "additionalProperties": false,
      "required": ["file_id", "case_id", "role", "path", "sha256"],
      "properties": {
        "file_id": {"type": "string", "minLength": 1},
        "case_id": {"type": "string", "minLength": 1},
        "role": {
          "enum": [
            "source",
            "source-units",
            "lesson-plan",
            "script",
            "storyboard",
            "candidate-input",
            "narration-input",
            "audio-input"
          ]
        },
        "path": {"type": "string", "minLength": 1},
        "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
      }
    }
  }
}
