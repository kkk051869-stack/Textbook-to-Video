{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://textbookeval.local/schemas/stability-report-v0.1.json",
  "title": "TextbookEval Stability Report v0.1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "run_id_prefix", "repeats", "stable_pass_at_n", "gate_flip_rate", "gates", "metrics", "issue_frequency", "worst_run", "run_success_rate", "candidate_failure_rate", "system_error_rate", "system_error_count", "candidate_failure_count", "runs", "metadata"],
  "properties": {
    "schema_version": {"const": "textbookeval-stability-v0.1"},
    "run_id_prefix": {"type": "string", "minLength": 1},
    "repeats": {"type": "integer", "minimum": 1},
    "stable_pass_at_n": {"type": "boolean"},
    "gate_flip_rate": {"type": ["number", "null"]},
    "gates": {"type": "object"},
    "metrics": {"type": "object"},
    "issue_frequency": {"type": "object"},
    "worst_run": {"type": "object"},
    "run_success_rate": {"type": "number", "minimum": 0, "maximum": 1},
    "candidate_failure_rate": {"type": "number", "minimum": 0, "maximum": 1},
    "system_error_rate": {"type": "number", "minimum": 0, "maximum": 1},
    "system_error_count": {"type": "integer", "minimum": 0},
    "candidate_failure_count": {"type": "integer", "minimum": 0},
    "runs": {"type": "array", "minItems": 1, "items": {"type": "object"}},
    "metadata": {"type": "object"}
  }
}
