# Default stays on edge-tts until a cloud backend is explicitly selected.
T2V_TTS_BACKEND=edge

# CosyVoice optional backend
T2V_COSYVOICE_PYTHON=/ai/data/tools/envs/cosyvoice3/bin/python
T2V_COSYVOICE_ROOT=/ai/data/tools/CosyVoice
T2V_COSYVOICE_MODEL=/ai/data/models/Fun-CosyVoice3-0.5B-2512
T2V_COSYVOICE_PROMPT_WAV=/ai/data/tools/CosyVoice/asset/zero_shot_prompt.wav
T2V_WETEXT_MODEL_DIR=/ai/data/model-cache/modelscope/hub/pengzhendong/wetext

# MegaTTS3 optional backend
T2V_MEGATTS3_PYTHON=/ai/data/tools/envs/cosyvoice3/bin/python
T2V_MEGATTS3_ROOT=/ai/data/repos/PresentAgent/presentagent/MegaTTS3
T2V_MEGATTS3_PROMPT_WAV=/ai/data/repos/PresentAgent/presentagent/MegaTTS3/assets/Chinese_prompt.wav
T2V_MEGATTS3_DEVICE=cuda
